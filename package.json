{
    "name": "xanh-garden",
    "version": "1.0.0",
    "private": true,
    "description": "Xanh Garden: online plant shop (frontend + backend)",
    "scripts": {
        "format": "prettier --write \"backend/**/*.{js,mjs}\" \"frontend/src/js/**/*.js\" frontend/vite.config.js",
