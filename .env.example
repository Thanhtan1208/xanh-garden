# Sao chép file này thành ".env" rồi điền thông tin, sau đó chạy lại: npm run server
# Muốn thử gửi mail mà không dùng Gmail thật: chạy "npm run mail" (hộp thư ảo), rồi đặt
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# và để trống SMTP_USER, SMTP_PASS. Xem thư tại http://localhost:1080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email-gui-di@gmail.com
# Mật khẩu ỨNG DỤNG 16 ký tự của Google (không phải mật khẩu đăng nhập Gmail)
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Xanh Garden <email-gui-di@gmail.com>

# Tài khoản nhận tiền hiển thị trên mã QR (SePay/VietQR)
SEPAY_BANK=MBBank
SEPAY_ACCOUNT=0000000000
SEPAY_ACCOUNT_NAME=XANH GARDEN
# Khóa webhook SePay (đặt khi nối với SePay thật)
# SEPAY_API_KEY=

# Chatbot tư vấn (OpenAI). Không đặt thì chatbot chạy chế độ tra cứu cơ sở tri thức.
# Lưu ý: nếu máy đã có biến môi trường hệ thống OPENAI_API_KEY thì biến đó được ưu tiên hơn file .env.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
