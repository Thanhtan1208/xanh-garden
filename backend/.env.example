# Sao chép file này thành ".env" rồi điền thông tin, sau đó chạy lại: npm run server
# Muốn thử gửi mail mà không dùng Gmail thật: chạy "npm run mail" (hộp thư ảo), rồi đặt
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# và để trống SMTP_USER, SMTP_PASS. Xem thư tại http://localhost:1080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email-gui-di@gmail.com
# Mật khẩu ỨNG DỤNG 16 ký tự của Google (không phải mật khẩu đăng nhập Gmail)
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Xanh Garden <email-gui-di@gmail.com>

# Tài khoản nhận tiền hiển thị trên mã QR (SePay/VietQR)
SEPAY_BANK=MBBank
SEPAY_ACCOUNT=0000000000
SEPAY_ACCOUNT_NAME=XANH GARDEN
# Khóa webhook SePay (đặt khi nối với SePay thật)
# SEPAY_API_KEY=

# Chatbot tư vấn (OpenAI). Không đặt thì chatbot chạy chế độ tra cứu cơ sở tri thức.
# Giá trị trong file .env được ưu tiên hơn biến môi trường cùng tên của máy.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== Chạy thật trên server (deploy) =====
# NODE_ENV=production thì server kiểm tra cấu hình khi khởi động, thiếu mục bắt buộc sẽ dừng và báo thiếu gì.
# NODE_ENV=production
# Bắt buộc: khóa ký token đăng nhập, ít nhất 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET=
# Bắt buộc: khóa webhook SePay riêng (chưa nối SePay thì đặt một chuỗi ngẫu nhiên tạo như trên)
# SEPAY_API_KEY=
# Mật khẩu mới cho tài khoản admin mẫu (Demo@Garden2026). Chỉ đổi tài khoản còn dùng mật khẩu mẫu,
# đổi xong có thể xóa dòng này. Cần đủ mạnh: 8+ ký tự, chữ hoa, chữ thường, số, ký tự đặc biệt.
# ADMIN_PASSWORD=
# Bật nút "Thanh toán (demo)" để thầy cô/khách thử luồng QR mà không chuyển tiền thật (production mặc định tắt)
# PAYMENT_DEMO=on
# Số proxy đứng trước server: bỏ trống nếu dùng Caddy/Nginx/Cloudflare Tunnel cùng máy, đặt 1 trên Render
# TRUST_PROXY=
# Cổng server (mặc định 3000) và thư mục dữ liệu (mặc định backend/data, trên Render là đường dẫn ổ đĩa gắn vào)
# PORT=3000
# DATA_DIR=
# Thư mục nhận thêm bản sao lưu mỗi ngày (db + ảnh tải lên), nên là thư mục Google Drive/OneDrive đang đồng bộ hoặc ổ khác
# BACKUP_COPY_DIR=
# Lưu dữ liệu vào PostgreSQL (Supabase: Project Settings > Database > Connection string > Session pooler).
# Để trống thì dùng data/db.json. Lần đầu chạy "npm run db:push" để đẩy dữ liệu và ảnh hiện có lên.
# DATABASE_URL=postgresql://postgres.xxxx:MAT-KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Gửi email qua Brevo bằng HTTPS (bắt buộc trên Render bản miễn phí vì cổng SMTP bị chặn). Có khóa này thì không dùng SMTP.
# Lấy khóa: brevo.com > SMTP & API > API Keys; xác minh email người gửi ở Senders, rồi đặt MAIL_FROM=Xanh Garden <email-do@gmail.com>
# BREVO_API_KEY=
